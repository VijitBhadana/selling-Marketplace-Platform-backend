# Supabase Postgres connection strings
# Pooled connection (used by the app at runtime)
# Keep connection_limit explicit: Prisma's default is (CPU cores x 2 + 1), which on a small
# 1-2 core server is only 3-5 connections — a burst of ~40 orders then fails with
# "Timed out fetching a new connection" (500s). 20 was measured as the sweet spot; the
# Supabase pooler's own pool caps the gain beyond that. Set the same URL on the host (Render).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=20"
# Direct connection (used by Prisma Migrate)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase project (used if you also access Supabase client-side features, e.g. storage)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Email OTP (Gmail SMTP via nodemailer)
# GMAIL_USER must have 2-Step Verification on; GMAIL_APP_PASSWORD is a 16-char
# App Password generated at https://myaccount.google.com/apppasswords (NOT your
# normal Gmail password). If these are unset, OTPs are logged to the server
# console instead of emailed — useful for local dev without Gmail creds.
GMAIL_USER="dukancloude@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# App
# Set to "production" on the deployed server. In production the backend REFUSES to boot
# with insecure defaults (JWT_SECRET / ADMIN_EMAIL / ADMIN_PASSWORD must be real), API docs
# are off, and CORS is closed unless CORS_ORIGIN is set.
NODE_ENV="development"
PORT=4000
# Comma-separated. Production: "https://dukancloude.com,https://www.dukancloude.com"
CORS_ORIGIN="http://localhost:3000"
# Set to "true" to expose Swagger (/api/docs) even in production. Leave unset in prod.
# ENABLE_SWAGGER="false"

# The single admin account, created automatically on startup (never via sign-up).
# These MUST be set to strong, unique values in production — the old public defaults
# (admin@gmail.com / Admin@123) are a full-takeover risk. NOTE: if an admin row already
# exists in the DB, the seeder keeps its existing password, so rotate that admin's
# password once after changing ADMIN_PASSWORD.
ADMIN_EMAIL="choose-a-real-admin-email"
ADMIN_PASSWORD="choose-a-long-random-password"


