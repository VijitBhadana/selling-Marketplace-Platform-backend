# Supabase Postgres connection strings
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (used by Prisma Migrate)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase project (used if you also access Supabase client-side features, e.g. storage)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Email OTP (Gmail SMTP via nodemailer)
# GMAIL_USER must have 2-Step Verification on; GMAIL_APP_PASSWORD is a 16-char
# App Password generated at https://myaccount.google.com/apppasswords (NOT your
# normal Gmail password). If these are unset, OTPs are logged to the server
# console instead of emailed — useful for local dev without Gmail creds.
GMAIL_USER="dukancloude@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# App
PORT=4000
# Comma-separated. Production: "https://dukancloude.com,https://www.dukancloude.com"
CORS_ORIGIN="http://localhost:3000"

# The single admin account, created automatically on startup (never via sign-up).
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="Admin@123"
